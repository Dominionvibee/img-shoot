# Keep the API path relative to use the Vite development proxy.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:4000

# Public v2 CHECKBOX site key from your own development registration.
# Set the same value as backend RECAPTCHA_SITE_KEY. Never put a secret here.
VITE_RECAPTCHA_SITE_KEY=

# Node frontend/preview API proxy. Public config is read from the backend;
# .env is loaded at startup and is never copied into the build.
API_PROXY_TARGET=http://localhost:4000
